# Files NOT copied into the Docker build context.
# Smaller context = faster builds + zero risk of leaking secrets into images.

# Dependencies (re-installed fresh in the Dockerfile)
node_modules
.pnpm-store

# Build output (re-built in the Dockerfile)
.next
out
dist
build

# Secrets — these MUST never enter an image
.env
.env.*
!.env.production.example
.kamal/secrets
.kamal/secrets.*

# Git + IDE noise
.git
.gitignore
.gitattributes
.github
.vscode
.idea
.DS_Store
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Tests (not needed in prod image)
tests
playwright-report
test-results
coverage
vitest.config.*
playwright.config.*

# Local-only
docker
media
public/uploads
docs

# Claude / editor artifacts
.claude

# Misc
README.md
*.md.bak
*.swp
